// onesignal:managed v1
// DELETABLE VERIFICATION FILE — delete this file and its call site in
// MainActivity.onCreate() once push delivery is confirmed.
//
// Every OneSignal API below is verified against the SDK source. In particular:
//   OneSignal.Notifications.requestPermission is a `suspend fun ... : Boolean`.
//   It has NO callback overload. Calling it as `requestPermission(true) { ... }`
//   is a fabrication that does not compile — call it from a coroutine as below.
//
// Placeholders: __PACKAGE__ (this file's package / module namespace),
//               __APP_ID__ (the public OneSignal App ID).
//
// The `BuildConfig.DEBUG` guard requires the app module's buildConfig feature.
// On AGP 8+ it is OFF by default — ensure the app's build.gradle.kts has:
//     android { buildFeatures { buildConfig = true } }
// (add it if missing; without it `BuildConfig` will not resolve).
//
// This file imports kotlinx.coroutines (to call the suspend `requestPermission`).
// The OneSignal SDK exposes kotlinx-coroutines only as a RUNTIME (implementation)
// dependency, not `api` — verified against com.onesignal:core Gradle module
// metadata: coroutines is in the java-runtime variant, absent from java-api. So it
// is NOT on the app's compile classpath transitively. If the app doesn't already
// use coroutines, add to the app module's build.gradle(.kts):
//     implementation("org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3")
// (1.7.3 is the version the SDK resolves at runtime; newer is fine).
package __PACKAGE__

import android.app.Activity
import android.app.AlertDialog
import android.app.Application
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.widget.EditText
import com.onesignal.OneSignal
import com.onesignal.user.subscriptions.IPushSubscriptionObserver
import com.onesignal.user.subscriptions.PushSubscriptionChangedState
import java.lang.ref.WeakReference
import java.net.HttpURLConnection
import java.net.URL
import java.util.concurrent.atomic.AtomicBoolean
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.launch
import org.json.JSONArray
import org.json.JSONObject

object OneSignalSetupVerification {
    // installed: wire up the observer + lifecycle callback once per process.
    // dialogShown: the dialog is presented at most once, and only when it truly
    // shows (see tryShow) — not the moment the id resolves.
    private val installed = AtomicBoolean(false)
    private val dialogShown = AtomicBoolean(false)
    // Track the foreground Activity instead of capturing the one passed to
    // installIfDebug: the subscription id can arrive after a rotation or a screen
    // change, when that Activity is destroyed. Presenting a dialog on a dead
    // Activity throws BadTokenException; holding it in the SDK observer leaks it.
    // @Volatile: written on the main thread (lifecycle callbacks) but read from
    // the SDK's observer callback, whose thread is not documented as main.
    @Volatile private var current: WeakReference<Activity> = WeakReference(null)
    @Volatile private var observer: IPushSubscriptionObserver? = null
    @Volatile private var pendingId: String? = null
    private val main = Handler(Looper.getMainLooper())

    private val lifecycle = object : Application.ActivityLifecycleCallbacks {
        override fun onActivityResumed(activity: Activity) {
            current = WeakReference(activity)
            tryShow() // a dialog may have been waiting for a live Activity
        }
        override fun onActivityCreated(activity: Activity, s: Bundle?) {}
        override fun onActivityStarted(activity: Activity) {}
        override fun onActivityPaused(activity: Activity) {}
        override fun onActivityStopped(activity: Activity) {}
        override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) {}
        override fun onActivityDestroyed(activity: Activity) {
            if (current.get() === activity) current = WeakReference(null)
        }
    }

    fun installIfDebug(activity: Activity) {
        if (!BuildConfig.DEBUG) return // never runs in release

        current = WeakReference(activity)
        // Guard re-entry: MainActivity.onCreate runs again on every rotation, so
        // wire up the observer + lifecycle callback exactly once. The line above
        // still refreshes the tracked Activity on each call.
        if (!installed.compareAndSet(false, true)) return
        activity.application.registerActivityLifecycleCallbacks(lifecycle)

        val obs = object : IPushSubscriptionObserver {
            override fun onPushSubscriptionChange(state: PushSubscriptionChangedState) {
                checkRegistration(state.current.id)
            }
        }
        observer = obs
        OneSignal.User.pushSubscription.addObserver(obs)

        // Race guard: the ID may already be assigned before the observer attaches.
        checkRegistration(OneSignal.User.pushSubscription.id)
    }

    private fun isRegistered(id: String): Boolean = id.isNotEmpty() && !id.startsWith("local-")

    private fun checkRegistration(subscriptionId: String) {
        if (!isRegistered(subscriptionId)) return
        pendingId = subscriptionId
        tryShow()
    }

    // Present once, but only when a live Activity exists. If none is foregrounded
    // yet (app in background when the id resolved), stay pending and retry from
    // onActivityResumed — never consume the one-shot without actually showing.
    private fun tryShow() {
        if (pendingId == null) return
        // Do the liveness re-check, the one-shot claim, and the teardown together
        // on the main thread inside the post. If the Activity dies during the hop
        // we return having consumed nothing (dialogShown/pendingId/observer stay
        // intact), so onActivityResumed can retry — the contract above. Reading
        // isFinishing/isDestroyed here also keeps it off the SDK's observer thread.
        main.post {
            val id = pendingId ?: return@post
            val presenter = current.get() ?: return@post
            if (presenter.isFinishing || presenter.isDestroyed) return@post
            if (!dialogShown.compareAndSet(false, true)) return@post // present once
            pendingId = null

            // Committed and showing: stop observing so the SDK drops its strong
            // reference to this object (and any Activity reachable through it).
            observer?.let { OneSignal.User.pushSubscription.removeObserver(it) }
            observer = null
            presenter.application.unregisterActivityLifecycleCallbacks(lifecycle)

            AlertDialog.Builder(presenter)
                .setTitle("Your OneSignal SDK integration is complete!")
                .setMessage("Tap 'Got it' to enable push notifications and send yourself a test message.")
                .setPositiveButton("Got it") { _, _ ->
                    // requestPermission is a suspend fun — call it from a coroutine.
                    CoroutineScope(Dispatchers.Main).launch {
                        val accepted = OneSignal.Notifications.requestPermission(true)
                        if (accepted) promptForTestMessage(presenter, id)
                    }
                }
                .setCancelable(false)
                .show()
        }
    }

    private fun promptForTestMessage(activity: Activity, subscriptionId: String) {
        val input = EditText(activity).apply { hint = "Enter message body" }
        AlertDialog.Builder(activity)
            .setTitle("Send Test Push")
            .setView(input)
            .setPositiveButton("Send") { _, _ ->
                val message = input.text.toString().ifEmpty { "Test from OneSignal!" }
                sendTestNotification(subscriptionId, message)
            }
            .setNegativeButton("Cancel", null)
            .show()
    }

    // Unauthenticated self-send (relies on the app's permit_unauth_notif_create
    // flag). On 401 it is not enabled for this app — fall back to a REST-key
    // send or a dashboard test (see references/api-reference.md).
    private fun sendTestNotification(subscriptionId: String, message: String) {
        Thread {
            try {
                val conn = (URL("https://api.onesignal.com/notifications").openConnection() as HttpURLConnection).apply {
                    requestMethod = "POST"
                    setRequestProperty("Content-Type", "application/json")
                    doOutput = true
                }
                val payload = JSONObject().apply {
                    put("app_id", "__APP_ID__")
                    put("include_subscription_ids", JSONArray().put(subscriptionId))
                    put("contents", JSONObject().put("en", message))
                }
                conn.outputStream.use { it.write(payload.toString().toByteArray()) }
                if (conn.responseCode !in 200..299) {
                    android.util.Log.w("OneSignalVerify", "Test send HTTP ${conn.responseCode}; use a REST key or the dashboard to send.")
                }
            } catch (e: Exception) {
                android.util.Log.e("OneSignalVerify", "Test send error", e)
            }
        }.start()
    }
}
